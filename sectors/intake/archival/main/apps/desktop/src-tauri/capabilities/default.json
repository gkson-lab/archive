{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "the main window: the api command, folder pickers, opening links and folders",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] }
  ]
}
